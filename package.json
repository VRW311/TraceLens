{
  "name": "tracelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:native": "cmake -S . -B build/native -DCMAKE_BUILD_TYPE=Release && cmake --build build/native --parallel 2",
    "build:wasm": "emcmake cmake -S . -B build/wasm -DCMAKE_BUILD_TYPE=Release && cmake --build build/wasm --parallel 2",
    "test:native": "ctest --test-dir build/native --output-on-failure",
    "test:wasm": "node tests/wasm-parity.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
